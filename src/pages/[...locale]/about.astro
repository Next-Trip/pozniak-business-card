---
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import Bio from "@components/about/Bio.astro";
import Footer from "@components/Footer.astro";

import { useTranslations, locales, defaultLocale } from "@i18n/ui";

export function getStaticPaths() {
  return locales.flatMap((l) => {
    if (l.code === defaultLocale) {
      return [
        { params: { locale: undefined } },
        { params: { locale: l.code } },
      ];
    }
    return [{ params: { locale: l.code } }];
  });
}

const currentLocale =
  Astro.params.locale || Astro.currentLocale || defaultLocale;
const t = useTranslations(currentLocale);

import bioData from "@data/bio.json";
const bio = bioData[currentLocale as keyof typeof bioData];
const pageDescription = `${bio.title} - ${t("site.hero_name")}. ${bio.content.slice(0, 150)}...`;

const title = t("site.hero_name") + " - " + t("site.page_title.about");
---

<Layout title={title} description={pageDescription}>
  <Header />
  <Bio />
  <Footer />
</Layout>
