---
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import About from "@components/About.astro";
import Events from "@components/Events.astro";
import PressQuotes from "@components/PressQuotes.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import Gallery from "@components/Gallery.astro";
import Workshops from "@components/Workshops.astro";

import { useTranslations, locales, defaultLocale } from "@i18n/ui";
import { getImage } from "astro:assets";
import backgroundImage from "@assets/bg.svg";

export function getStaticPaths() {
  return locales.flatMap((l) => {
    if (l.code === defaultLocale) {
      return [
        { params: { locale: undefined } },
        { params: { locale: l.code } },
      ];
    }
    return [{ params: { locale: l.code } }];
  });
}

const currentLocale =
  Astro.params.locale || Astro.currentLocale || defaultLocale;
const t = useTranslations(currentLocale);

import homepageData from "@data/homepage.json";
const homeData = homepageData[currentLocale as keyof typeof homepageData];
const pageDescription = `${t("site.hero_name")} - ${homeData.hero_subtitle}. ${homeData.about_description.slice(0, 150)}...`;

const optimizedBackground = await getImage({ src: backgroundImage });
---

<Layout title={t("site.hero_name")} description={pageDescription}>
  <Header />
  <main>
    <div
      class="pointer-events-none fixed inset-0 z-[-2] opacity-20"
      style={`background-image: url(${optimizedBackground.src}); background-repeat: no-repeat; background-size: cover; background-position: center; background-attachment: fixed;`}
    >
    </div>
    <Hero />
    <About />
    <Events />
    <PressQuotes />
    <Workshops />
    <Gallery />
    <Footer />
  </main>
</Layout>
