---
import { Icon } from "astro-icon/components";
import LanguageDropdown from "@components/LanguageDropdown.astro";
import SocialLinks from "@components/SocialLinks.astro";

import { getRelativeLocaleUrl } from "astro:i18n";

import { useTranslations } from "@i18n/ui";
import type { UiKey } from "@i18n/ui";

const t = useTranslations(Astro.currentLocale);

const localeBase = getRelativeLocaleUrl(Astro.currentLocale ?? "en", "");

const navItems: { labelKey: UiKey; href: string }[] = [
  {
    labelKey: "site.nav_about",
    href: getRelativeLocaleUrl(Astro.currentLocale ?? "en", "about"),
  },
  {
    labelKey: "site.nav_events",
    href: `${localeBase}#events`,
  },
  {
    labelKey: "site.nav_press",
    href: `${localeBase}#press`,
  },
  {
    labelKey: "site.nav_gallery",
    href: `${localeBase}#gallery`,
  },
  {
    labelKey: "site.nav_contacts",
    href: `${localeBase}#footer`,
  },
];
---

<div
  class="mt-(--header-height) fixed justify-between inset-0 bg-brand-tertiary/95 z-60 flex flex-col p-6 backdrop-blur-md transition-all duration-300 ease-in-out opacity-0 pointer-events-none -translate-y-4"
  id="mobile-nav-overlay"
>
  <nav class="flex flex-col space-y-5 mt-10">
    {
      navItems.map((item, index) => (
        <a
          class="mobile-nav-link font-headline-md text-brand-primary hover:pl-4 transition-all duration-300 ease-in-out border-b border-brand-primary/20 pb-4 opacity-0 translate-y-2"
          style={`transition-delay: ${index * 60 + 80}ms;`}
          href={item.href}
        >
          {t(item.labelKey)}
        </a>
      ))
    }
  </nav>

  <div class="mobile-nav-footer transition-all duration-300 ease-in-out opacity-0 translate-y-2 delay-300">
    <div class="mb-6">
      <LanguageDropdown
        class="flex gap-2 items-center font-body-lg uppercase"
        variant="inline"
      />
    </div>

    <SocialLinks />
  </div>
</div>

<header
  class="fixed h-(--header-height) top-0 w-full z-50 backdrop-blur-md bg-brand-tertiary/80 text-brand-primary"
>
  <div
    class="flex justify-between items-center px-6 md:pl-16 md:pr-6 py-2 h-20 max-w-7xl mx-auto"
  >
    <a
      class="font-headline-md uppercase tracking-tighter"
      href={getRelativeLocaleUrl(Astro.currentLocale ?? "en", "")}
      >{t("site.hero_name")}
    </a>

    <button
      class="md:hidden text-brand-primary cursor-pointer transition-transform active:scale-95 relative w-8 h-8 flex items-center justify-center"
      id="open-menu-btn"
      aria-expanded="false"
      aria-label="Toggle menu"
    >
      <Icon
        name="mdi:menu"
        width="32"
        height="32"
        class="menu-icon-open absolute transition-all duration-300 ease-in-out transform rotate-0 opacity-100 scale-100"
      />
      <Icon
        name="mdi:close"
        width="32"
        height="32"
        class="menu-icon-close absolute transition-all duration-300 ease-in-out transform -rotate-90 opacity-0 scale-75"
      />
    </button>

    <nav class="hidden md:flex space-x-8">
      {
        navItems.map((item) => (
          <a
            class="text-body-md uppercase tracking-widest text-brand-primary-on-surface hover:text-brand-primary transition-colors duration-300"
            href={item.href}
          >
            {t(item.labelKey)}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:flex space-x-2">
      <LanguageDropdown />
    </div>
  </div>
</header>
<div style="height: var(--header-height);"></div>

<script>
  function setupMobileMenu() {
    const button = document.getElementById("open-menu-btn");
    const menu = document.getElementById("mobile-nav-overlay");
    const navLinks = document.querySelectorAll(".mobile-nav-link");
    const navFooter = menu?.querySelector(".mobile-nav-footer");

    button?.addEventListener("click", toggleMenu);

    navLinks.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    function toggleMenu() {
      const isExpanded = button?.getAttribute("aria-expanded") === "true";
      const nextExpanded = !isExpanded;
      button?.setAttribute("aria-expanded", nextExpanded.toString());

      const iconOpen = button?.querySelector(".menu-icon-open");
      const iconClose = button?.querySelector(".menu-icon-close");

      if (nextExpanded) {
        // Open
        iconOpen?.classList.add("rotate-90", "opacity-0", "scale-75");
        iconOpen?.classList.remove("rotate-0", "opacity-100", "scale-100");

        iconClose?.classList.add("rotate-0", "opacity-100", "scale-100");
        iconClose?.classList.remove("-rotate-90", "opacity-0", "scale-75");

        menu?.classList.remove("opacity-0", "pointer-events-none", "-translate-y-4");
        menu?.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");

        navLinks.forEach((link) => {
          link.classList.remove("opacity-0", "translate-y-2");
          link.classList.add("opacity-100", "translate-y-0");
        });

        navFooter?.classList.remove("opacity-0", "translate-y-2");
        navFooter?.classList.add("opacity-100", "translate-y-0");
      } else {
        closeMenu();
      }
    }

    function closeMenu() {
      button?.setAttribute("aria-expanded", "false");

      const iconOpen = button?.querySelector(".menu-icon-open");
      const iconClose = button?.querySelector(".menu-icon-close");

      iconOpen?.classList.remove("rotate-90", "opacity-0", "scale-75");
      iconOpen?.classList.add("rotate-0", "opacity-100", "scale-100");

      iconClose?.classList.remove("rotate-0", "opacity-100", "scale-100");
      iconClose?.classList.add("-rotate-90", "opacity-0", "scale-75");

      menu?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
      menu?.classList.add("opacity-0", "pointer-events-none", "-translate-y-4");

      navLinks.forEach((link) => {
        link.classList.remove("opacity-100", "translate-y-0");
        link.classList.add("opacity-0", "translate-y-2");
      });

      navFooter?.classList.remove("opacity-100", "translate-y-0");
      navFooter?.classList.add("opacity-0", "translate-y-2");
    }
  }

  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
