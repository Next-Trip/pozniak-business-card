---
import { Icon } from "astro-icon/components";
import LanguageDropdown from "@components/LanguageDropdown.astro";
import SocialLinks from "@components/SocialLinks.astro";

import { getRelativeLocaleUrl } from "astro:i18n";

import { useTranslations } from "@i18n/ui";
import type { UiKey } from "@i18n/ui";

const t = useTranslations(Astro.currentLocale);

const localeBase = getRelativeLocaleUrl(Astro.currentLocale ?? "en", "");

const navItems: { labelKey: UiKey; href: string }[] = [
  {
    labelKey: "site.nav_about",
    href: getRelativeLocaleUrl(Astro.currentLocale ?? "en", "about"),
  },
  {
    labelKey: "site.nav_events",
    href: `${localeBase}#events`,
  },
  {
    labelKey: "site.nav_press",
    href: `${localeBase}#press`,
  },
  {
    labelKey: "site.nav_gallery",
    href: `${localeBase}#gallery`,
  },
  {
    labelKey: "site.nav_contacts",
    href: `${localeBase}#footer`,
  },
];
---

<div
  class="bg-brand-tertiary/95 pointer-events-none fixed inset-x-0 top-(--header-height) bottom-0 z-60 flex max-h-[calc(100dvh-var(--header-height))] -translate-y-4 flex-col justify-between overflow-y-auto p-6 opacity-0 backdrop-blur-md transition-all duration-300 ease-in-out"
  id="mobile-nav-overlay"
>
  <nav class="mt-4 flex flex-col space-y-4 sm:mt-6 sm:space-y-5">
    {
      navItems.map((item, index) => (
        <a
          class="mobile-nav-link font-headline-md text-brand-primary border-brand-primary/20 translate-y-2 border-b pb-4 opacity-0 transition-all duration-300 ease-in-out hover:pl-4"
          style={`transition-delay: ${index * 60 + 80}ms;`}
          href={item.href}
        >
          {t(item.labelKey)}
        </a>
      ))
    }
  </nav>

  <div
    class="mobile-nav-footer mt-8 translate-y-2 opacity-0 transition-all delay-300 duration-300 ease-in-out"
  >
    <div class="mb-6">
      <LanguageDropdown
        class="font-body-lg flex items-center gap-2 uppercase"
        variant="inline"
      />
    </div>

    <SocialLinks />
  </div>
</div>

<header
  class="bg-brand-tertiary/80 text-brand-primary fixed top-0 z-50 h-(--header-height) w-full backdrop-blur-md"
>
  <div
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 py-2 md:pr-6 md:pl-16"
  >
    <a
      class="font-headline-md tracking-tighter uppercase"
      style="line-height: 0.9;"
      href={getRelativeLocaleUrl(Astro.currentLocale ?? "en", "")}
      >{t("site.hero_name")}
    </a>

    <button
      class="text-brand-primary relative flex h-8 w-8 cursor-pointer items-center justify-center transition-transform active:scale-95 md:hidden"
      id="open-menu-btn"
      aria-expanded="false"
      aria-label="Toggle menu"
    >
      <Icon
        name="mdi:menu"
        width="32"
        height="32"
        class="menu-icon-open absolute scale-100 rotate-0 transform opacity-100 transition-all duration-300 ease-in-out"
      />
      <Icon
        name="mdi:close"
        width="32"
        height="32"
        class="menu-icon-close absolute scale-75 -rotate-90 transform opacity-0 transition-all duration-300 ease-in-out"
      />
    </button>

    <nav class="hidden space-x-8 md:flex">
      {
        navItems.map((item) => (
          <a
            class="text-body-md text-brand-primary-on-surface hover:text-brand-primary tracking-widest uppercase transition-colors duration-300"
            href={item.href}
          >
            {t(item.labelKey)}
          </a>
        ))
      }
    </nav>

    <div class="hidden space-x-2 md:flex">
      <LanguageDropdown />
    </div>
  </div>
</header>
<div style="height: var(--header-height);"></div>

<script>
  function setupMobileMenu() {
    const button = document.getElementById("open-menu-btn");
    const menu = document.getElementById("mobile-nav-overlay");
    const navLinks = document.querySelectorAll(".mobile-nav-link");
    const navFooter = menu?.querySelector(".mobile-nav-footer");

    button?.addEventListener("click", toggleMenu);

    navLinks.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    function toggleMenu() {
      const isExpanded = button?.getAttribute("aria-expanded") === "true";
      const nextExpanded = !isExpanded;
      button?.setAttribute("aria-expanded", nextExpanded.toString());

      const iconOpen = button?.querySelector(".menu-icon-open");
      const iconClose = button?.querySelector(".menu-icon-close");

      if (nextExpanded) {
        // Open
        document.body.classList.add("overflow-hidden");

        iconOpen?.classList.add("rotate-90", "opacity-0", "scale-75");
        iconOpen?.classList.remove("rotate-0", "opacity-100", "scale-100");

        iconClose?.classList.add("rotate-0", "opacity-100", "scale-100");
        iconClose?.classList.remove("-rotate-90", "opacity-0", "scale-75");

        menu?.classList.remove(
          "opacity-0",
          "pointer-events-none",
          "-translate-y-4",
        );
        menu?.classList.add(
          "opacity-100",
          "pointer-events-auto",
          "translate-y-0",
        );

        navLinks.forEach((link) => {
          link.classList.remove("opacity-0", "translate-y-2");
          link.classList.add("opacity-100", "translate-y-0");
        });

        navFooter?.classList.remove("opacity-0", "translate-y-2");
        navFooter?.classList.add("opacity-100", "translate-y-0");
      } else {
        closeMenu();
      }
    }

    function closeMenu() {
      document.body.classList.remove("overflow-hidden");
      button?.setAttribute("aria-expanded", "false");

      const iconOpen = button?.querySelector(".menu-icon-open");
      const iconClose = button?.querySelector(".menu-icon-close");

      iconOpen?.classList.remove("rotate-90", "opacity-0", "scale-75");
      iconOpen?.classList.add("rotate-0", "opacity-100", "scale-100");

      iconClose?.classList.remove("rotate-0", "opacity-100", "scale-100");
      iconClose?.classList.add("-rotate-90", "opacity-0", "scale-75");

      menu?.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0",
      );
      menu?.classList.add("opacity-0", "pointer-events-none", "-translate-y-4");

      navLinks.forEach((link) => {
        link.classList.remove("opacity-100", "translate-y-0");
        link.classList.add("opacity-0", "translate-y-2");
      });

      navFooter?.classList.remove("opacity-100", "translate-y-0");
      navFooter?.classList.add("opacity-0", "translate-y-2");
    }
  }

  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
