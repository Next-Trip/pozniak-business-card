---
import { Image } from "astro:assets";
import aboutImage from "@assets/images/about-side.jpg";
import { getRelativeLocaleUrl } from "astro:i18n";

import homepageData from "@data/homepage.json";
const content =
  homepageData[(Astro.currentLocale ?? "en") as keyof typeof homepageData];

import { marked } from "marked";
const about_description = marked.parse(content.about_description);

import { useTranslations } from "@i18n/ui";
import type { Locale } from "@i18n/ui";
const locale = Astro.currentLocale as Locale;
const t = useTranslations(locale);
---

<section class="fade-in-section px-6 py-32 md:px-16" id="about">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col items-center gap-16 md:flex-row">
      <div class="relative w-full md:w-5/12">
        <div class="relative aspect-3/4 overflow-hidden rounded-sm">
          <Image
            class="h-full w-full object-cover"
            src={aboutImage}
            alt="Veronika Pozniak portrait"
            format="webp"
            widths={[320, 640, 960]}
            sizes="(max-width: 768px) 100vw, 40vw"
            loading="lazy"
          />
        </div>
      </div>
      <div class="w-full md:w-7/12 md:pl-12">
        <h2 class="text-brand-primary relative mb-8 inline-block">
          {content.about_title}
          <span class="bg-brand-primary absolute -bottom-2 left-0 h-px w-1/3"
          ></span>
        </h2>
        <div
          class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl space-y-6"
        >
          <article class="prose" set:html={about_description} />
        </div>
        <div class="mt-12 flex justify-end gap-6">
          <a
            class="border-brand-primary font-label-sm hover:bg-brand-primary text-brand-primary inline-flex border px-6 py-3 tracking-widest uppercase transition-all hover:text-[#F1EDE4]"
            href={getRelativeLocaleUrl(Astro.currentLocale ?? "en", "about")}
          >
            <span>{t("about.cta")}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
