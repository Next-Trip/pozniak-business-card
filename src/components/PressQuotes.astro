---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { marked } from "marked";
import { useTranslations, defaultLocale } from "@i18n/ui";

const currentLocale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(currentLocale);

const pressCollection = await getCollection("press", ({ id }: any) => {
  return id.startsWith(currentLocale + "/") || id.startsWith(currentLocale);
});

const sortedPress = [...pressCollection].sort((a, b) => {
  const posA = a.data.position ?? -Infinity;
  const posB = b.data.position ?? -Infinity;

  return posA - posB;
});

import EmblaCarousel from "@components/EmblaCarousel.astro";
const pdfPath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/md_3-1704474865.pdf`;
---

<section class="fade-in-section px-6 py-32 md:px-16" id="press">
  <div class="text-brand-primary mx-auto grid justify-center text-center">
    {
      sortedPress.length > 1 ? (
        <EmblaCarousel autoScroll={true} loop={true}>
          {sortedPress.map((press) => (
            <article
              class="embla__slide prose font-body-md text-brand-primary-on-surface"
              set:html={marked.parse(press.data.quote)}
            />
          ))}
        </EmblaCarousel>
      ) : (
        sortedPress.map((press) => (
          <article
            class="embla__slide prose font-body-md text-brand-primary-on-surface"
            set:html={marked.parse(press.data.quote)}
          />
        ))
      )
    }

    <div
      class="mt-12 flex w-full flex-col items-center justify-center gap-4 md:flex-row md:gap-8"
    >
      <div class="flex">
        <Icon name="mdi:radio" width="24" height="24" />
        <a
          class="ml-2"
          href="https://www.mujrozhlas.cz/nocni-mikroforum/host-veronika-pozniak-hudebnice-herecka"
          target="_blank"
          rel="noopener noreferrer">{t("press.listen_radio")}</a
        >
      </div>
      <div class="flex">
        <Icon name="mdi:newspaper-variant-outline" width="24" height="24" />
        <a
          class="ml-2"
          href="https://porohy.cz/veronika-poznyak-spiv-shho-yednaye-narodi-i-zczilyuye-serczya/"
          target="_blank"
          rel="noopener noreferrer">{t("press.read_article")}</a
        >
      </div>
      <div class="flex">
        <Icon name="mdi:download" width="24" height="24" />
        <a class="ml-2" href={pdfPath} target="_blank" rel="noopener noreferrer"
          >{t("press.download_article")}</a
        >
      </div>
    </div>
  </div>
</section>
