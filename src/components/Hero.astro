---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import coverImage from "@assets/images/cover.jpg";
import homepageData from "@data/homepage.json";
const content =
  homepageData[(Astro.currentLocale ?? "en") as keyof typeof homepageData];

import { useTranslations } from "@i18n/ui";
const t = useTranslations(Astro.currentLocale);
---

<section
  class="relative flex min-h-[90vh] items-end px-6 pt-32 pb-24 md:min-h-screen md:items-center md:px-16 md:pb-0"
>
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute inset-0 z-10 bg-black/20"></div>
    <Image
      src={coverImage}
      alt={`${t("site.hero_name")} cover photo`}
      format="webp"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-center"
    />
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-end justify-between gap-8 md:flex-row md:items-center"
  >
    <div class="w-full md:w-1/2">
      <h1
        class="font-display-lg-mobile md:font-display-lg mb-4 leading-none tracking-tighter text-white uppercase mix-blend-difference drop-shadow-md"
      >
        {t("site.hero_name")}
      </h1>
      <p
        class="font-body-lg text-body-lg mb-8 tracking-widest text-white/90 uppercase mix-blend-difference"
      >
        {content.hero_subtitle}
      </p>

      <!-- Social Links -->
      <div class="flex space-x-6">
        <a
          aria-label="Instagram"
          class="text-white transition-colors hover:text-[#eeb7d1]"
          href="https://www.instagram.com/vpozniak_music"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="mdi:instagram" width="24" height="24" />
        </a>
        <a
          aria-label="Facebook"
          class="text-white transition-colors hover:text-[#eeb7d1]"
          href="https://www.facebook.com/profile.php?id=61575866916326"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="mdi:facebook" width="24" height="24" />
        </a>
        <a
          aria-label="Youtube"
          class="text-white transition-colors hover:text-[#eeb7d1]"
          href="https://youtube.com/@veronikapozniak?si=A26cpsOYInxNovC7"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="mdi:youtube" width="24" height="24" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .font-display-lg-mobile {
    font-family: var(--font-eb-garamond);
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
  }

  .font-display-lg {
    font-family: var(--font-eb-garamond);
    font-size: 72px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
</style>
