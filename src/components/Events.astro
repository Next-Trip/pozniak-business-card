---
import { Icon } from "astro-icon/components";

import { getCollection } from "astro:content";
import { marked } from "marked";

import { useTranslations, defaultLocale } from "@i18n/ui";
const currentLocale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(currentLocale);

const allEvents = await getCollection("events", ({ id }: any) => {
  return id.startsWith(currentLocale + "/") || id.startsWith(currentLocale);
});

const sortedEvents = [...allEvents].sort((a, b) => {
  const posA = a.data.position ?? -Infinity;
  const posB = b.data.position ?? -Infinity;

  return posA - posB;
});
---

<section class="fade-in-section bg-[#f7f3ef] px-6 py-32 md:px-16" id="events">
  <div class="mx-auto max-w-7xl">
    <h2 class="text-brand-primary mb-16 text-center">
      {t("events.title")}
    </h2>
    <div class="mx-auto flex max-w-4xl flex-col space-y-6">
      {
        sortedEvents.map((event: any) => (
          <div class="border-brand-primary/20 hover:border-brand-primary flex flex-col items-start justify-between gap-6 border-b pb-8 transition-colors md:flex-row md:items-center">
            <div>
              <div class="font-label-sm text-brand-secondary mb-2 tracking-widest uppercase">
                {event.data.date.toLocaleDateString()}
              </div>
              <h3 class="text-brand-primary">{event.data.title}</h3>
              <article
                class="prose font-body-md text-brand-primary-on-surface"
                set:html={marked.parse(event.data.description)}
              />
            </div>
            <div class="flex items-center gap-4">
              <a
                class="font-label-sm text-label-sm text-brand-primary group-hover:border-brand-primary flex items-center gap-2 border-b border-transparent tracking-widest uppercase transition-all"
                href={event.data.button_link}
              >
                {event.data.button_text}
                <Icon name="mdi:arrow-forward" width="16" height="16" />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
