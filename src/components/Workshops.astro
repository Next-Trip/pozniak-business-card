---
import { useTranslations, defaultLocale } from "@i18n/ui";
const currentLocale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(currentLocale);

import { getCollection } from "astro:content";
import { marked } from "marked";

const allWorkshops = await getCollection("workshops", ({ id }: any) => {
  return id.startsWith(currentLocale + "/") || id.startsWith(currentLocale);
});

const sortedWorkshops = [...allWorkshops].sort((a, b) => {
  const posA = a.data.position ?? -Infinity;
  const posB = b.data.position ?? -Infinity;

  return posA - posB;
});
---

<section
  class="fade-in-section bg-[#f7f3ef] px-6 py-32 md:px-16"
  id="masterclasses"
>
  <div class="mx-auto max-w-7xl">
    <h2 class="text-brand-primary mb-16 text-center">{t("workshops.title")}</h2>
    {
      sortedWorkshops.map((workshop: any) => (
        <div class="mx-auto flex max-w-4xl flex-col space-y-12">
          <div class="group border-brand-primary/20 hover:border-brand-primary flex flex-col items-start justify-between gap-8 border-b pb-8 transition-colors md:flex-row">
            <div>
              <h3 class="mb-2">{workshop.data.title}</h3>
              <div class="font-label-sm text-brand-secondary mb-2 tracking-widest uppercase">
                {workshop.data.start_date.toLocaleDateString()} -{" "}
                {workshop.data.end_date.toLocaleDateString()}
              </div>
              <article
                class="prose"
                set:html={marked.parse(workshop.data.description)}
              />
            </div>
            <div class="flex w-full items-center justify-end md:w-0">
              <a
                class="border-brand-primary font-label-sm hover:bg-brand-primary text-brand-primary hover:text-brand-tertiary inline-flex items-center justify-center border px-6 py-3 tracking-widest text-nowrap uppercase transition-all"
                href={workshop.data.button_link}
              >
                {workshop.data.button_text}
              </a>
            </div>
          </div>
        </div>
      ))
    }
    <div class="mt-16 text-center">
      <p class="font-body-lg text-brand-primary-on-surface mb-8 italic">
        {t("workshops.individual.title")}
      </p>
      <a
        class="bg-brand-primary text-brand-tertiary font-label-sm hover:bg-surface-tint hover:text-brand-primary hover:border-brand-primary inline-flex items-center justify-center px-8 py-4 tracking-widest uppercase transition-colors"
        href="#footer"
      >
        {t("workshops.individual.request")}
      </a>
    </div>
  </div>
</section>
