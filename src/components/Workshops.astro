---
import { useTranslations, defaultLocale } from "@i18n/ui";
const currentLocale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(currentLocale);

import { getCollection } from "astro:content";
import { marked } from "marked";

const allWorkshops = await getCollection("workshops", ({ id }: any) => {
  return id.startsWith(currentLocale + "/") || id.startsWith(currentLocale);
});

const sortedWorkshops = [...allWorkshops].sort((a, b) => {
  const posA = a.data.position ?? -Infinity;
  const posB = b.data.position ?? -Infinity;

  return posA - posB;
});
---

<section
  class="py-32 px-6 md:px-16 bg-[#f7f3ef] fade-in-section"
  id="masterclasses"
>
  <div class="max-w-7xl mx-auto">
    <h2 class="text-brand-primary mb-16 text-center">{t("workshops.title")}</h2>
    {
      sortedWorkshops.map((workshop: any) => (
        <div class="max-w-4xl mx-auto flex flex-col space-y-12">
          <div class="group border-b border-brand-primary/20 pb-8 flex flex-col md:flex-row justify-between items-start gap-8 hover:border-brand-primary transition-colors">
            <div>
              <h3 class="mb-2">{workshop.data.title}</h3>
              <div class="font-label-sm text-brand-secondary uppercase tracking-widest mb-2">
                {workshop.data.start_date.toLocaleDateString()} -{" "}
                {workshop.data.end_date.toLocaleDateString()}
              </div>
              <article
                class="prose"
                set:html={marked.parse(workshop.data.description)}
              />
            </div>
            <div class="flex items-center w-full md:w-0 justify-end">
              <a
                class="text-nowrap inline-flex items-center justify-center px-6 py-3 border border-brand-primary font-label-sm uppercase tracking-widest hover:bg-brand-primary text-brand-primary hover:text-[#F1EDE4] transition-all"
                href={workshop.data.button_link}
              >
                {workshop.data.button_text}
              </a>
            </div>
          </div>
        </div>
      ))
    }
    <div class="mt-16 text-center">
      <p class="font-body-lg text-brand-primary-on-surface mb-8 italic">
        {t("workshops.individual.title")}
      </p>
      <a
        class="inline-flex items-center justify-center px-8 py-4 bg-brand-primary text-[#F1EDE4] font-label-sm uppercase tracking-widest hover:bg-surface-tint hover:text-brand-primary hover:border-brand-primary transition-colors"
        href="#footer"
      >
        {t("workshops.individual.request")}
      </a>
    </div>
  </div>
</section>
