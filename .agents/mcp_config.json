{
  "mcpServers": {
    "astro-docs": {
      "serverUrl": "https://mcp.docs.astro.build/mcp"
    },
    "tailwindcss": {
      "command": "npx",
      "args": ["-y", "tailwindcss-mcp-server"],
      "env": {
        "NODE_OPTIONS": "--import data:text/javascript,console.log=console.error;"
      }
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "typescript": {
      "command": "npx",
      "args": ["-y", "typescript-mcp-server"]
    }
  }
}
